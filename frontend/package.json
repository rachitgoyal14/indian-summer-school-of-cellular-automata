{
  "name": "sarak-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React + PixiJS frontend for the CA Rule 184 traffic simulator",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
