    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
