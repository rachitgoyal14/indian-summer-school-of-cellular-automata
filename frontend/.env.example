# Frontend Environment Variables for Production Deployment

# WebSocket URL for the backend API (Railway deployment)
# This should point to your deployed Railway backend's WebSocket endpoint.
# Format: wss://<your-railway-app>.railway.app/ws
# Example: wss://ca-backend-production.railway.app/ws
#
# For local development, leave this unset - Vite's proxy will handle it.
# For production (Vercel), set this in the Vercel dashboard under Environment Variables.
VITE_BACKEND_WS_URL=wss://your-railway-backend.railway.app/ws
