{
  "_comment": "Hand-editable batch scenario: a 3x3 grid that floods at step 200 and is repaired at step 400. Send it as {\"type\": \"run_scenario\", \"scenario\": <this file>}. A scenario saved from the live view is also a valid input - just add a \"batch\" block to it.",

  "config": "grid",
  "seed": 7,
  "density": 0.30,
  "car_fraction": 0.30,
  "lane_change_prob": 0.30,
  "build_kwargs": { "rows": 3, "cols": 3, "seg": 40 },

  "batch": {
    "steps": 600,
    "record_every": 1,
    "snapshot_every": 100,
    "include_segments": true,

    "schedule": [
      {
        "step": 200,
        "action": "block_cells",
        "road_id": 4,
        "cells": [18, 19, 20, 21, 22],
        "permanent": true,
        "kind": "flood",
        "label": "monsoon flood"
      },
      {
        "step": 400,
        "action": "clear_disruptions",
        "kind": "flood"
      }
    ]
  }
}
